# ---- Server ----
PORT=4000
# Cho phép CORS từ frontend dev. Khi deploy đổi thành domain thật.
CLIENT_ORIGIN=http://localhost:5173

# ---- Google Gemini (Vision) ----
# Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# ---- MongoDB (lưu trữ chính) ----
# Local: mongodb://127.0.0.1:27017/ops_reports
# Atlas: mongodb+srv://user:pass@cluster.../ops_reports
MONGO_URI=mongodb://127.0.0.1:27017/ops_reports

# ---- Realtime driver ----
# Chọn 1 trong 2: "socket" (mặc định, không cần cấu hình thêm) hoặc "firebase"
REALTIME_DRIVER=socket

# ---- Nếu dùng Firebase Realtime Database (REALTIME_DRIVER=firebase) ----
# Đường dẫn tới file service-account.json tải từ Firebase Console > Project settings > Service accounts
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# Database URL, ví dụ https://my-project-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DATABASE_URL=
