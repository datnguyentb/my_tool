# Khi deploy, trỏ tới backend thật. Khi dev để trống vì dùng Vite proxy.
VITE_API_BASE=

# Realtime driver khớp với backend: "socket" (mặc định) hoặc "firebase"
VITE_REALTIME_DRIVER=socket

# Nếu dùng Firebase (VITE_REALTIME_DRIVER=firebase): cấu hình web app từ Firebase Console
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
